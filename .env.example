# Application
SECRET_KEY=change-me-to-random-string
HOST=0.0.0.0
PORT=8000

# Initial admin user (created on first start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Data
DATA_DIR=/app/data

# PostgreSQL
DATABASE_URL=postgresql://factory:factory@postgres:5432/factory
POSTGRES_PASSWORD=factory

# GitLab
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=factory
MINIO_SECRET_KEY=factoryminio
MINIO_PASSWORD=factoryminio

# RabbitMQ
RABBITMQ_URL=amqp://factory:factory@rabbitmq:5672/
RABBITMQ_PASSWORD=factory
